# Browser-safe Supabase configuration (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only scraper credentials. Never prefix these with VITE_.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
GEMINI_API_KEY=
# auto: bounded MTProto attempt then public HTTPS fallback; https: skip MTProto.
TELEGRAM_TRANSPORT=auto
# Optional, server-only PostgreSQL URL for applying migrations; not the service key.
SUPABASE_DB_URL=
# Also configure these in Vercel runtime settings to serve the live website feed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated public usernames or numeric IDs of channels you may access.
# Supply your actual Iraqi medical/dental job channels; none are assumed.
TELEGRAM_CHANNELS=
# Keep this SQLite session private; authorize once with --login.
TELEGRAM_SESSION=telegram_scraper
TELEGRAM_FETCH_LIMIT=100
# Optional trusted production origin for authenticated publishing.
APP_ORIGIN=https://projecta-jobs.vercel.app

# Persistent-host alternative: authorize --login once, then run --listen.
# Keep TELEGRAM_SESSION and TELEGRAM_OUTBOX on persistent, private storage.
TELEGRAM_OUTBOX=.telegram_outbox

# Bot notifications: server-only; never prefix these with VITE_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_SECRET=

# WhatsApp Cloud API: server-only. Templates require Meta approval.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# v17.0 matches the requested URL; select a supported version before production.
WHATSAPP_GRAPH_API_VERSION=v17.0
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Optional verified-job distribution receivers (server-only; never VITE_).
# These are your integration webhooks, not Telegram/Meta API endpoints.
TELEGRAM_JOB_WEBHOOK_URL=
WHATSAPP_JOB_WEBHOOK_URL=
# Independent random secrets, at least 32 characters each.
JOB_BROADCAST_WEBHOOK_SECRET=
JOB_BROADCAST_DISPATCH_SECRET=
