{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/telegram/link",
      "destination": "/api/verifications?notification=telegram-link"
    },
    {
      "source": "/api/telegram/webhook",
      "destination": "/api/verifications?notification=telegram-webhook"
    },
    {
      "source": "/api/whatsapp/preferences",
      "destination": "/api/verifications?notification=whatsapp-preferences"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/telegram-sync.py": {
      "maxDuration": 300,
      "includeFiles": "{telegram_scraper.py,telegram_sync.py,telegram_pipeline.py,iraq_taxonomy.py,config/iraq.json}"
    },
    "api/directory.js": {
      "maxDuration": 60
    },
    "api/verifications.js": {
      "includeFiles": "lib/*.ts"
    },
    "api/applications.js": {
      "includeFiles": "lib/*.ts"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
