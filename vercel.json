{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/telegram-sync.py": {
      "maxDuration": 300,
      "includeFiles": "{telegram_scraper.py,telegram_sync.py,telegram_pipeline.py,iraq_taxonomy.py,config/iraq.json}"
    },
    "api/directory.js": {
      "maxDuration": 60
    }
  }
}
