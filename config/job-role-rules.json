    "Medical Reps": "مندوب(?:ه|ين|ات)?\\s*(?:علمي(?:ه|ين)?|طبي(?:ه|ين)?)|مداوبين\\s*علميين|تمثيل\\s*طبي|medical\\s+(?:rep|representative)|scientific\\s+rep",
    "Receptionists / Admin": "استقبال|سكرت(?:ير|يره|اريه)|اداري(?:ه|ين)?|محاسب(?:ه)?|receptionist|secretar|administrator",
    "General Physicians": "(?:طبيب(?:ه)?|اطباء)\\s*(?:عام(?:ه|ين)?|بشري(?:ه|ين)?|طب\\s*عام)|\\bgeneral\\s+(?:physician|practitioner)s?\\b|\\bGPs?\\b"
  }
